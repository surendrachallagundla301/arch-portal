{
  "realm": "arch-portal",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "SUBMITTER", "description": "Can submit and view architecture requests" },
      { "name": "ARB_REVIEWER", "description": "Architecture Review Board member; can record decisions" }
    ]
  },
  "clients": [
    {
      "clientId": "portal-frontend",
      "name": "Architecture Portal (Angular)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Submitter",
      "email": "alice@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["SUBMITTER"]
    },
    {
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Reviewer",
      "email": "bob@example.com",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["SUBMITTER", "ARB_REVIEWER"]
    }
  ]
}
